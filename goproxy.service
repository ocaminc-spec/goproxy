[Unit]
Description=GoProxy DNS (ad-blocking caching DNS) + dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=goproxy
ExecStart=/usr/local/bin/goproxy -dns-addr :53 -http-addr :8080 -cache-gb 4
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=120
LimitNOFILE=1048576
Nice=0
# Allow up to cache budget + headroom; adjust with -cache-gb.
MemoryMax=70G

[Install]
WantedBy=multi-user.target
